* text=auto

*.cff text eol=lf
*.cjs text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.lean text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.png binary

# The portable harness and proof envelope bind exact source bytes.  Do not let
# platform checkout settings rewrite those bytes before their manifests run.
software/harness/** -text
proofs/native/** -text
proofs/native/SOURCE_MANIFEST.json -diff
