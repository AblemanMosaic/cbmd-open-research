import OAI.Algorithms.SubexponentialSAT.SqrtLog.NativeAmplitudeScalarBridge

/-!
# Linear generalized-binomial recurrence

This module realizes the exact recurrence used by the declared BCM-1 closed
route.  It is a value theorem only: operation and bit-cost accounting are kept
as a separate obligation.
-/

namespace OAI.Algorithms.SubexponentialSAT.SqrtLog.LayoutNumerator

/-- Executable generalized binomial coefficients generated by the one-step
exact-division recurrence. -/
def generalizedChooseLinear (N : ℤ) : ℕ → ℤ
  | 0 => 1
  | k + 1 =>
      generalizedChooseLinear N k * (N - (k : ℤ)) / ((k + 1 : ℕ) : ℤ)

/-- Multiplicative step for integral generalized binomial coefficients. -/
theorem ringChoose_mul_step (N : ℤ) (k : ℕ) :
    Ring.choose N k * (N - (k : ℤ)) =
      Ring.choose N (k + 1) * ((k + 1 : ℕ) : ℤ) := by
  have h := Ring.choose_smul_choose (r := N) (n := k + 1) (k := k)
    (Nat.le_succ k)
  simpa [Ring.choose_one_right, nsmul_eq_mul, mul_comm] using h.symm

/-- The recurrence computes Mathlib's integral `Ring.choose`, for positive and
negative upper arguments alike. -/
theorem generalizedChooseLinear_eq_ringChoose (N : ℤ) :
    ∀ k : ℕ, generalizedChooseLinear N k = Ring.choose N k := by
  intro k
  induction k with
  | zero => simp [generalizedChooseLinear, Ring.choose_zero_right]
  | succ k ih =>
      rw [generalizedChooseLinear, ih]
      apply Int.ediv_eq_of_eq_mul_left
      · omega
      · exact ringChoose_mul_step N k

/-- The corresponding negative-binomial coefficient, expressed through the
same fixed-upper recurrence at `-A`. -/
def negativeBinomialLinear (A k : ℕ) : ℤ :=
  (-1 : ℤ) ^ k * generalizedChooseLinear (-(A : ℤ)) k

theorem negativeBinomialLinear_eq (A k : ℕ) :
    negativeBinomialLinear A k = negativeBinomialCoeff A k := by
  rw [negativeBinomialLinear, generalizedChooseLinear_eq_ringChoose]
  have hchoose := Ring.choose_neg' (R := ℤ) (A : ℤ) k
  change Ring.choose (-(A : ℤ)) k =
    (((k : ℤ).negOnePow : ℤ) * Ring.multichoose (A : ℤ) k) at hchoose
  rw [Int.coe_negOnePow_natCast,
    ← negativeBinomialCoeff_eq_multichoose] at hchoose
  rw [hchoose]
  calc
    (-1 : ℤ) ^ k *
        ((-1 : ℤ) ^ k * negativeBinomialCoeff A k) =
      (((-1 : ℤ) ^ k * (-1 : ℤ) ^ k) *
        negativeBinomialCoeff A k) := by ring
    _ = negativeBinomialCoeff A k := by
      rw [← mul_pow]
      norm_num

end OAI.Algorithms.SubexponentialSAT.SqrtLog.LayoutNumerator
